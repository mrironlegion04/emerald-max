# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Required for production: DATABASE_URL, SESSION_SECRET, CRON_SECRET.

# Database - replace with your PostgreSQL connection string
DATABASE_URL="postgresql://cmms_user:change-me@localhost:5432/cmms_db"

# Session secret - REQUIRED. Unique random string, 32+ chars.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# ─── existing vars ────────────────────────────────────────────────────────────
# Public base URL of the app. MUST be the real production URL in production
# (it is used for links in emails, push notifications, presigned URLs, and
# CSRF origin checks). Do not leave this at localhost.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── email notifications ───────────────────────────────────────────────────────
# Option A: Gmail (enable "App Passwords" in your Google account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="CMMS <you@gmail.com>"

# Option B: Mailtrap (free, for development/testing - emails go to inbox, not real people)
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your-mailtrap-user
# EMAIL_PASS=your-mailtrap-pass
# EMAIL_FROM="CMMS <noreply@cmms.local>"

# Option C: No email (leave EMAIL_USER blank - emails silently skipped)
# EMAIL_USER=

# ─── cron job ─────────────────────────────────────────────────────────────────
# REQUIRED. Random string, 16+ chars. Call the endpoints with header:
# Authorization: Bearer <CRON_SECRET>
# Endpoints: POST /api/cron/pm-generate, POST /api/notifications/digest
# Generate with: openssl rand -hex 16
CRON_SECRET=""

# ─── file storage (minio) ──────────────────────────────────────────────────────
# MinIO configuration for attachment storage
# For local development: use http://localhost:9000 with default credentials
# For production: use your MinIO/S3 endpoint with secure credentials
MINIO_ENDPOINT=http://localhost:9000
MAX_MINIO_ACCESS_KEY=cmms_user
MAX_MINIO_SECRET_KEY=cmms_password
MINIO_BUCKET_NAME=cmms-attachments
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

FACE_SERVICE_URL=http://localhost:8000

# Gemini API Key for Procedural Generation
GEMINI_API_KEY=

# ─── web push notifications ────────────────────────────────────────────────────
# Generate a VAPID keypair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"

# ─── telegram bot ──────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram, then paste the token here
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── one-time production seed ─────────────────────────────────────────────────
# Only used by `npx prisma db seed` (prod mode). NEVER set this to a
# well-known password. Delete this block from `.env` after the first seed.
# SEED_ADMIN_PASSWORD=

# ─── production checklist ──────────────────────────────────────────────────────
# [ ] NEXT_PUBLIC_BASE_URL points at the real domain (HTTPS)
# [ ] SESSION_SECRET / CRON_SECRET are random and unique
# [ ] DATABASE_URL uses a strong password
# [ ] MINIO creds are non-default and bucket is private
# [ ] EMAIL_USER/EMAIL_PASS are app-password credentials
# [ ] Remove the "Actual" secrets block that used to live here (git history
#     is scrubbed via `git filter-repo` or by rotating every credential below)
