generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  REQUESTER
}

enum WOVisibility {
  FULL
  LIMITED
}

enum TeamMemberRole {
  ADMIN
  MEMBER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  PENDING_APPROVAL
  COMPLETED
  CLOSED
  CANCELLED
}

enum SubtaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderType {
  BREAKDOWN
  PREVENTIVE
  PREDICTIVE
}

enum LocationScope {
  ALL_ASSETS      // "All Assets in this Location" - checklist mode
  GENERAL         // "None / General Maintenance" - location-only ticket
}

enum PMFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum RequestType {
  REPAIR
  MAINTENANCE
  INSPECTION
  INSTALLATION
  OTHER
}

enum PMTriggerType {
  TIME
  METER
  TIME_OR_METER
}

enum ScheduleBehavior {
  FIXED      // Next WO due date calculated from current due date
  FLOATING   // Next WO due date calculated from completion date
}

enum MeterType {
  RUNTIME
  DISTANCE
  CYCLE
  TEMPERATURE
  PRESSURE
  CUSTOM
}

enum ReadingSource {
  MANUAL
  IOT
  IMPORT
}

enum ReadingStatus {
  VALID
  SUSPECT
  REJECTED
}

enum MeterEventType {
  READING_CREATED
  THRESHOLD_REACHED
  PM_TRIGGERED
  VALIDATION_WARNING
  VALIDATION_ERROR
  STATUS_CHANGED
}

enum CompletionType {
  ASSIGNED
  ADMIN_OVERRIDE
  MANAGER_OVERRIDE
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}



enum NotificationType {
  WORK_ORDER_ASSIGNED
  WORK_ORDER_COMPLETED
  METER_ALERT
  PM_GENERATED
  STOCK_LOW
  CHAT
  REQUEST
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProficiencyLevel {
  BASIC
  INTERMEDIATE
  EXPERT
}

enum ChatChannelType {
  general
  team
  workorder
  direct
  group
}

// ── Models ───────────────────────────────────────────────────────────────────

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("CustomUserRole")

  @@map("custom_roles")
}

model Team {
  id          String    @id @default(cuid())
  name        String
  trade       String
  description String?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?
  restoredAt  DateTime?
  restoredBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members    TeamMember[]
  domains    TeamDomain[]
  userScopes UserTeamScope[] @relation("TeamUserScopes")
  workOrders WorkOrder[]
  subtasks   Subtask[]    @relation("SubtasksAssignedToTeam")
  pmSchedules MaintenanceSchedule[] @relation("PMTeamAssigned")
  templates   WorkOrderTemplate[]
  woPerformers WorkOrderPerformer[] @relation("WOPerformerTeam")
  requests   MaintenanceRequest[] @relation("RequestTeam")

  @@map("teams")
}

model TeamMember {
  id       String         @id @default(cuid())
  role     TeamMemberRole @default(MEMBER)

  teamId   String
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamDomain {
  teamId     String
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  domainId   String
  domain     MaintenanceDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([teamId, domainId])
  @@map("team_domains")
}

model UserTeamScope {
  userId String
  user   User @relation("UserTeamScopes", fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team @relation("TeamUserScopes", fields: [teamId], references: [id], onDelete: Cascade)

  canCloseWO        Boolean @default(true)
  canAssignWO       Boolean @default(true)
  canEditWO         Boolean @default(true)
  canApproveRequest Boolean @default(true)
  canConvertRequest Boolean @default(true)
  canManagePM       Boolean @default(true)
  canManageAssets   Boolean @default(true)

  createdAt DateTime @default(now())

  @@id([userId, teamId])
  @@map("user_team_scopes")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TECHNICIAN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profile fields
  phone        String?
  bio          String?
  department   String?

  // Visibility & permissions
  woVisibility WOVisibility @default(FULL)
  customRoleId String?
  customRole   CustomRole?  @relation("CustomUserRole", fields: [customRoleId], references: [id], onDelete: SetNull)

  // Performance tracking
  totalAssignedWOs   Int     @default(0)
  totalCompletedWOs  Int     @default(0)
  averageRating      Float   @default(0)
  lastActiveAt       DateTime?

  // Face verification fields
  hasFaceVerification Boolean @default(false)
  facePhotoUrl        String?
  lastFaceVerifyAt    DateTime?

  // Telegram integration
  telegramChatId String?

  assignedWorkOrders    WorkOrder[]             @relation("AssignedTo")
  createdWorkOrders     WorkOrder[]             @relation("CreatedBy")
  completedWorkOrders   WorkOrder[]             @relation("WOCompletedBy")
  reviewedRequests      MaintenanceRequest[]    @relation("RequestReviewer")
  submittedRequests     MaintenanceRequest[]    @relation("RequestRequester")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  assignedSubtasks      Subtask[]               @relation("SubtaskAssignedTo")
  completedSubtasks     Subtask[]               @relation("SubtaskCompletedBy")
  createdSubtasks       Subtask[]               @relation("SubtaskCreatedBy")
  skills                UserSkill[]              @relation("UserSkills")
  ownedAssets           Asset[]
  createdAssets         Asset[]                 @relation("AssetCreatedBy")
  createdParts          Part[]                  @relation("PartCreatedBy")
  createdPMSchedules    MaintenanceSchedule[]   @relation("PMCreatedBy")
  assignedPMSchedules   MaintenanceSchedule[]   @relation("PMAssignedTo")
  assignedPMTasks       PmScheduleTask[]        @relation("PMTaskAssignedTo")
  statusChanges         WorkOrderStatusHistory[] @relation("StatusChangedBy")
  repairSessionsStarted   RepairSession[] @relation("RepairSessionStartedBy")
  repairSessionsCompleted RepairSession[] @relation("RepairSessionCompletedBy")

  uploadedAttachments   Attachment[]            @relation("AttachmentUploadedBy")
  recordedReadings      MeterReading[]          @relation("MeterReadingRecordedBy")
  workOrderComments     WorkOrderComment[]      @relation("CommentAuthor")
  commentReactions      CommentReaction[]       @relation("CommentReactionUser")

  sentMessages          ChatMessage[]           @relation("ChatMessageSender")
  chatChannelMemberships ChatChannelMember[]     @relation("ChannelMemberships")

  teamMemberships       TeamMember[]
  teamScopes            UserTeamScope[] @relation("UserTeamScopes")
  userLocations         UserLocation[]
  createdTemplates      WorkOrderTemplate[] @relation("TemplateCreatedBy")
  assignedTemplates     WorkOrderTemplate[] @relation("TemplateAssignedTo")
  createdAutomationRules AutomationRule[]   @relation("AutomationRuleCreator")
  telegramPairings       TelegramPairing[]
  woPerformers           WorkOrderPerformer[] @relation("WOPerformerUser")
  woPerformersAddedBy    WorkOrderPerformer[] @relation("WOPerformerAddedBy")

  @@map("users")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSkills UserSkill[] @relation("SkillUsers")

  @@map("skills")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  proficiencyLevel ProficiencyLevel @default(INTERMEDIATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation("UserSkills", fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation("SkillUsers", fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String?  // short plant prefix used in WO numbers, e.g. "A", "B"
  address   String?
  parentId  String?
  path      String?  // cached breadcrumb: "Plant A › Building 2 › Line 3"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[] @relation("LocationHierarchy")
  assets    Asset[]
  workOrders WorkOrder[] @relation("WorkOrdersAtLocation")
  maintenanceSchedules MaintenanceSchedule[] @relation("PMSchedulesAtLocation")
  userLocations UserLocation[]

  @@map("locations")
}

model UserLocation {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@id([userId, locationId])
  @@map("user_locations")
}

model AssetCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  parent   AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id])
  children AssetCategory[] @relation("AssetCategoryHierarchy")
  assets   Asset[]
  domains  CategoryDomain[]
  pmSchedules MaintenanceSchedule[] @relation("PMCategoryAssigned")
  workOrders WorkOrder[] @relation("WOCategory")
  templates  WorkOrderTemplate[]

  defaultDomainId String?
  defaultDomain   MaintenanceDomain? @relation("CategoryDefaultDomain", fields: [defaultDomainId], references: [id], onDelete: SetNull)

  @@map("asset_categories")
}

model AssetType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@map("asset_types")
}

model Asset {
  id                String      @id @default(cuid())
  name              String
  assetCode         String?     @unique
  description       String?
  status            AssetStatus @default(ACTIVE)
  serialNumber      String?
  model             String?
  manufacturer      String?
  purchaseDate      DateTime?
  purchaseCost      Float?
  assetTypeId       String?
  criticality       Criticality?
  domainId          String?
  domain            MaintenanceDomain? @relation("AssetDomain", fields: [domainId], references: [id], onDelete: SetNull)
  customFields      Json?
  // Warranty fields (Part 7)
  warrantyExpiry    DateTime?
  warrantyNotes     String?
  // Meter-based PM fields
  meterUnit         String?
  currentMeterValue Float?
  // Maintenance metrics (source data only — derived metrics computed on the fly)
  totalFailures        Int      @default(0)
  lastFailureDate      DateTime?
  lastRepairDate       DateTime?
  totalRepairTime      Int      @default(0)  // cumulative repair minutes
  totalDowntimeMinutes Int      @default(0)  // cumulative downtime minutes
  // Hierarchy (Part 7)
  parentId          String?
  parent            Asset?      @relation("AssetHierarchy", fields: [parentId], references: [id])
  children          Asset[]     @relation("AssetHierarchy")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  locationId String?
  location   Location?      @relation(fields: [locationId], references: [id])
  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id])
  assetType  AssetType?     @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?          @relation(fields: [ownerId], references: [id])
  createdById String?
  createdBy  User?          @relation("AssetCreatedBy", fields: [createdById], references: [id])

  workOrders           WorkOrder[]
  workOrderAssets      WorkOrderAsset[]
  maintenanceSchedules MaintenanceSchedule[]
  pmScheduleLinks      MaintenanceScheduleAsset[]
  meters               Meter[]
  meterReadings        MeterReading[]
  attachments          Attachment[]          @relation("AssetAttachments")
  assetParts           AssetPart[]           @relation("AssetToAssetPart")
  requests             MaintenanceRequest[]  @relation("RequestAsset")

  // Soft-delete (archive) support
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  restoredAt DateTime?
  restoredBy String?

  // Primary asset image
  imageUrl  String?
  imageName String?

  @@map("assets")
}

model Meter {
  id        String    @id @default(cuid())
  name      String
  meterType MeterType @default(CUSTOM)
  unit      String
  description String?
  isPrimary Boolean   @default(false)
  allowDecrease  Boolean @default(false)
  maxDeltaPerDay Float?
  minDeltaPerDay Float?
  lastValue    Float?
  lastReadingAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assetId String
  asset   Asset   @relation(fields: [assetId], references: [id])
  readings MeterReading[]
  events   MeterEvent[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([assetId, isPrimary])
  @@index([assetId, deletedAt])
  @@map("meters")
}

model MeterEvent {
  id        String        @id @default(cuid())
  eventType MeterEventType
  payload   Json          @default("{}")
  createdAt DateTime      @default(now())

  meterId   String
  meter     Meter         @relation(fields: [meterId], references: [id])
  readingId String?
  reading   MeterReading? @relation(fields: [readingId], references: [id])

  @@index([meterId, createdAt])
  @@index([eventType, createdAt])
  @@map("meter_events")
}



model WorkOrder {
  id          String            @id @default(cuid())
  woNumber    String            @unique
  title       String
  description String?
  type        WorkOrderType     @default(BREAKDOWN)
  status      WorkOrderStatus   @default(OPEN)
  priority    WorkOrderPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  startedAt   DateTime?
  respondedAt DateTime?
  completedAt DateTime?
  closedAt    DateTime?
  requestedCompletionTime  DateTime?
  requestedCompletionNotes String?
  laborHours  Float?
  laborCost   Float?
  partsCost   Float?
  notes       String?
  customFields Json?

  otherProblemDescription String?
  hasCustomProblemDescription Boolean @default(false)

  isMandatorySignature Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assetId      String?
  asset        Asset?  @relation(fields: [assetId], references: [id])
  locationId   String?
  location     Location? @relation("WorkOrdersAtLocation", fields: [locationId], references: [id])
  locationScope LocationScope? // null for asset-based WOs, set for location-based WOs
  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  domainId     String?
  domain       MaintenanceDomain? @relation("WorkOrderDomain", fields: [domainId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?   @relation("CreatedBy", fields: [createdById], references: [id])
  completedById String?
  completedBy  User?   @relation("WOCompletedBy", fields: [completedById], references: [id])
  completionType CompletionType @default(ASSIGNED)
  issueId      String?
  issue        Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  customIssue  String?   // free-text when user picks "Other"

  maintenanceScheduleId String?
  maintenanceSchedule   MaintenanceSchedule? @relation("PMScheduleWorkOrders", fields: [maintenanceScheduleId], references: [id])

  categoryId String?
  category   AssetCategory? @relation("WOCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  // Nested PM tracking
  nestedLevel   Int?     // Index in the nestedConfig array (0 = base)
  nestedLabel   String?  // Display label like "Quarterly Deep Clean"

  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  partsUsed     WorkOrderPart[]
  comments      WorkOrderComment[]
  subtasks      Subtask[]
requests      MaintenanceRequest[]
  attachments         Attachment[]        @relation("WOAttachments")
  assets        WorkOrderAsset[]
  statusHistory WorkOrderStatusHistory[]
  repairSessions RepairSession[]
  performers    WorkOrderPerformer[]

  @@index([issueId, createdAt])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([domainId])
  @@index([assetId])
  @@index([locationId])
  @@index([teamId])
  @@index([createdAt])
  @@map("work_orders")
}

model WorkOrderAsset {
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  source    String?   // "DIRECT" | "LOCATION_SCOPE"
  createdAt DateTime @default(now())

  @@id([workOrderId, assetId])
  @@map("work_order_assets")
}

// ── Issue System ─────────────────────────────────────────────────────────────

model MaintenanceDomain {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues             IssueDomain[]
  categories         CategoryDomain[]
  teams              TeamDomain[]
  workOrders         WorkOrder[]        @relation("WorkOrderDomain")
  assets             Asset[]            @relation("AssetDomain")
  assignedSubtasks   Subtask[]          @relation("SubtasksAssignedToDomain")
  defaultCategories  AssetCategory[]    @relation("CategoryDefaultDomain")

  @@map("maintenance_domains")
}

model Issue {
  id        String        @id @default(cuid())
  code      String        @unique
  title     String
  severity  IssueSeverity @default(MEDIUM)
  isActive  Boolean       @default(true)
  isGlobal  Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  domains    IssueDomain[]
  workOrders WorkOrder[]
  requests   MaintenanceRequest[] @relation("RequestIssue")

  @@index([isActive, isGlobal, sortOrder])
  @@map("issues")
}

model IssueDomain {
  issueId  String
  domainId String

  issue  Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  domain MaintenanceDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([issueId, domainId])
  @@map("issue_domains")
}

model CategoryDomain {
  categoryId String
  domainId   String

  category AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  domain   MaintenanceDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([categoryId, domainId])
  @@map("category_domains")
}

model Part {
  id          String   @id @default(cuid())
  name        String
  partNumber  String   @unique
  description String?
  unitCost    Float?
  unit        String   @default("pcs")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("PartCreatedBy", fields: [createdById], references: [id])

  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  restoredAt DateTime?
  restoredBy String?

  usedInWorkOrders WorkOrderPart[]
  attachments      Attachment[]    @relation("PartAttachments")
  assetParts       AssetPart[]     @relation("PartToAssetPart")
  bomTemplateParts BOMTemplatePart[] @relation("PartToBOMTemplatePart")

  @@map("parts")
}

model WorkOrderPart {
  id       String @id @default(cuid())
  quantity Int
  unitCost Float?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  partId      String
  part        Part      @relation(fields: [partId], references: [id])

  @@map("work_order_parts")
}

model AssetPart {
  assetId String
  asset   Asset @relation("AssetToAssetPart", fields: [assetId], references: [id], onDelete: Cascade)
  partId  String
  part    Part  @relation("PartToAssetPart", fields: [partId], references: [id], onDelete: Cascade)

  expectedQuantity Int @default(1)

  @@id([assetId, partId])
  @@map("asset_parts")
}

model BOMTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts       BOMTemplatePart[]

  @@map("bom_templates")
}

model BOMTemplatePart {
  templateId  String
  template    BOMTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  partId      String
  part        Part        @relation("PartToBOMTemplatePart", fields: [partId], references: [id], onDelete: Cascade)
  
  expectedQuantity Int @default(1)

  @@id([templateId, partId])
  @@map("bom_template_parts")
}

model MaintenanceSchedule {
  id            String        @id @default(cuid())
  title         String
  description   String?
  triggerType   PMTriggerType @default(TIME)
  frequency     PMFrequency
  interval      Int           @default(1)
  nextDueDate   DateTime
  meterInterval      Float?
  meterUnit          String?
  meterId            String?
  meter              Meter?             @relation(fields: [meterId], references: [id], onDelete: SetNull)
  lastTriggeredValue Float?
  isActive           Boolean            @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Schedule behavior (MaintainX-style)
  scheduleBehavior  ScheduleBehavior @default(FIXED)
  lastCompletedAt   DateTime?        // When the last WO from this schedule was completed

  // Scheduling horizon — how many future WOs to pre-generate
  schedulingHorizon Int  @default(1)

  // Nested PM — array of { label, frequency, interval, runEvery, enabled }
  nestedConfig      Json?
  nestedCounter     Int  @default(0)  // Increments each time WOs are generated
  nestedStartIndex  Int  @default(0)  // Starting point in nested cycle (for mid-cycle setup)

  // WO Template — defaults applied to generated work orders
  woPriority        WorkOrderPriority @default(MEDIUM)
  woDescription     String?           // Additional description appended to WO description
  woAssignedToId    String?           // Default assignee for generated WOs
  woAssignedTo      User?             @relation("PMAssignedTo", fields: [woAssignedToId], references: [id])
  woTeamId          String?           // Default team for generated WOs
  woTeam            Team?             @relation("PMTeamAssigned", fields: [woTeamId], references: [id], onDelete: SetNull)
  woCategoryId      String?           // Default category for generated WOs
  woCategory        AssetCategory?    @relation("PMCategoryAssigned", fields: [woCategoryId], references: [id], onDelete: SetNull)

  // Start date offset — WO startDate = dueDate - N days
  startDateOffset   Int  @default(0)

  assetId             String?
  asset               Asset?             @relation(fields: [assetId], references: [id])
  assets              MaintenanceScheduleAsset[]
  locationId          String?
  location            Location?          @relation("PMSchedulesAtLocation", fields: [locationId], references: [id])
  locationScope       LocationScope?
  workOrders          WorkOrder[]        @relation("PMScheduleWorkOrders")
  tasks               PmScheduleTask[]   @relation("PMScheduleTasks")
  createdById         String?
  createdBy           User?              @relation("PMCreatedBy", fields: [createdById], references: [id])

  @@index([locationId])
  @@map("maintenance_schedules")
}

model MaintenanceScheduleAsset {
  scheduleId String
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([scheduleId, assetId])
  @@map("maintenance_schedule_assets")
}

model PmScheduleTask {
  id            String                @id @default(cuid())
  title         String
  order         Int                   @default(0)
  required      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  scheduleId    String
  schedule      MaintenanceSchedule   @relation("PMScheduleTasks", fields: [scheduleId], references: [id], onDelete: Cascade)
  assignedToId  String?
  assignedTo    User?                 @relation("PMTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([scheduleId])
  @@map("pm_schedule_tasks")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String
  entityName String
  changes    String?
  userId     String?
  userName   String?
  userEmail  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WorkOrderComment {
  id          String    @id @default(cuid())
  content     String
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  authorRole  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reactions   CommentReaction[] @relation("CommentReactions")
  attachments Attachment[]      @relation("CommentAttachments")

  @@index([workOrderId])
  @@map("work_order_comments")
}

model CommentReaction {
  id        String           @id @default(cuid())
  commentId String
  comment   WorkOrderComment @relation("CommentReactions", fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User?            @relation("CommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

model Subtask {
  id            String          @id @default(cuid())
  title         String
  description   String?
  status        SubtaskStatus   @default(PENDING)
  priority      WorkOrderPriority @default(MEDIUM)
  dueDate       DateTime?
  order         Int             @default(0)
  required      Boolean         @default(true)
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workOrderId   String
  workOrder     WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assignedToId  String?
  assignedTo    User?           @relation("SubtaskAssignedTo", fields: [assignedToId], references: [id])
  assignedDomainId String?
  assignedDomain   MaintenanceDomain? @relation("SubtasksAssignedToDomain", fields: [assignedDomainId], references: [id], onDelete: SetNull)
  assignedTeamId   String?
  assignedTeam     Team?              @relation("SubtasksAssignedToTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?           @relation("SubtaskCompletedBy", fields: [completedById], references: [id])
  completionType CompletionType @default(ASSIGNED)
  createdById   String?
  createdBy     User?           @relation("SubtaskCreatedBy", fields: [createdById], references: [id])

  @@index([workOrderId])
  @@index([assignedToId])
  @@index([assignedDomainId])
  @@index([assignedTeamId])
  @@index([completedById])
  @@map("subtasks")
}

// ── Part 7 new models ────────────────────────────────────────────────────────

model MaintenanceRequest {
  id              String        @id @default(cuid())
  requestNumber   String?       @unique
  title           String
  description     String
  location        String?
  requesterName   String
  requesterEmail  String?
  requesterPhone  String?
  priority        RequestPriority @default(MEDIUM)
  requestType     RequestType?
  desiredDate     DateTime?
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  requesterId  String?
  requester    User?    @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?    @relation("RequestReviewer", fields: [reviewedById], references: [id])
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])

  assetId String?
  asset   Asset?  @relation("RequestAsset", fields: [assetId], references: [id], onDelete: SetNull)

  issueId String?
  issue   Issue?  @relation("RequestIssue", fields: [issueId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation("RequestTeam", fields: [teamId], references: [id], onDelete: SetNull)

  attachments Attachment[] @relation("RequestAttachments")

  @@index([requesterId])
  @@index([issueId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@map("maintenance_requests")
}

model Attachment {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById String?
  uploadedBy   User?     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime? // For presigned URLs

  workOrderId String?
  workOrder   WorkOrder? @relation("WOAttachments", fields: [workOrderId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation("AssetAttachments", fields: [assetId], references: [id], onDelete: Cascade)

  partId String?
  part   Part?   @relation("PartAttachments", fields: [partId], references: [id], onDelete: Cascade)

  requestId String?
  request   MaintenanceRequest? @relation("RequestAttachments", fields: [requestId], references: [id], onDelete: Cascade)

  commentId String?
  comment   WorkOrderComment? @relation("CommentAttachments", fields: [commentId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([assetId])
  @@index([partId])
  @@index([requestId])
  @@index([commentId])
  @@map("attachments")
}

model MeterReading {
  id          String        @id @default(cuid())
  value       Float
  readingDate DateTime
  notes       String?
  source      ReadingSource @default(MANUAL)
  status      ReadingStatus @default(VALID)
  createdAt   DateTime      @default(now())

  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id])

  assetId      String
  asset        Asset  @relation(fields: [assetId], references: [id])
  recordedById String?
  recordedBy   User?  @relation("MeterReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  events MeterEvent[]

  @@index([meterId, readingDate])
  @@index([assetId, readingDate])
  @@index([readingDate])
  @@map("meter_readings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  entityId  String?
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model ChatChannel {
  id          String   @id @default(cuid())
  name        String
  type        ChatChannelType
  description String?
  avatarText  String?
  entityId    String?  // References teamId, workOrderId, etc., if linked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChatChannelMember[]
  messages    ChatMessage[]

  @@index([type])
  @@map("chat_channels")
}

model ChatChannelMember {
  id         String   @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ChannelMemberships", fields: [userId], references: [id], onDelete: Cascade)
  
  lastReadAt DateTime @default(now())
  isMuted    Boolean  @default(false)
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

model ChatMessage {
  id            String   @id @default(cuid())
  content       String
  channelId     String
  channelRel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channel       String   // Keep as string helper for backward compatibility
  channelName   String
  senderId      String
  sender        User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderName    String
  senderRole    Role     @default(TECHNICIAN)
  
  // Optional relations
  workOrderId   String?
  receiverId    String?
  domainId      String?
  
  // Attachment fields
  mediaUrl      String?
  mediaName     String?
  mediaType     String?
  isVoice       Boolean  @default(false)
  voiceDuration String?
  
  // Self relation for threading replies
  parentId      String?
  parent        ChatMessage?   @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ChatMessage[]  @relation("ThreadReplies")

  isEdited      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([parentId])
  @@index([createdAt])
  @@map("chat_messages")
}

model WorkOrderStatusHistory {
  id            String          @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  status        WorkOrderStatus
  changedById   String?
  changedBy     User?           @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([workOrderId, createdAt])
  @@map("work_order_status_history")
}

model WorkOrderPerformer {
  id           String   @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  userId       String?
  user         User?    @relation("WOPerformerUser", fields: [userId], references: [id], onDelete: SetNull)
  performerName String

  teamId       String?
  team         Team?    @relation("WOPerformerTeam", fields: [teamId], references: [id], onDelete: SetNull)
  teamName     String?
  role         String?

  addedById    String?
  addedBy      User?    @relation("WOPerformerAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedByName  String

  createdAt    DateTime @default(now())

  @@unique([workOrderId, userId])
  @@index([workOrderId])
  @@map("work_order_performers")
}

model WorkOrderTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  woType      WorkOrderType @default(PREVENTIVE)
  priority    WorkOrderPriority @default(MEDIUM)
  woDescription String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?    @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?    @relation("TemplateAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("work_order_templates")
}

model RepairSession {
  id              String    @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sessionNo       Int       // 1, 2, 3 — per WO, increments on each reopen cycle
  startedAt       DateTime
  completedAt     DateTime?
  durationMinutes Int?      // completedAt - startedAt in minutes (set on completion)
  startedById     String?
  startedBy       User?     @relation("RepairSessionStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedById   String?
  completedBy     User?     @relation("RepairSessionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@unique([workOrderId, sessionNo])
  @@index([workOrderId])
  @@map("repair_sessions")
}

model AutomationRule {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  priority    Int     @default(0) // higher = runs first

  // Trigger: what event fires this rule
  triggerType String // WO_CREATED, WO_COMPLETED, WO_OVERDUE, PM_GENERATED, PART_LOW_STOCK, SCHEDULE_DUE

  // Conditions: JSON array of { field, operator, value }
  // Operators: equals, not_equals, contains, greater_than, less_than, in
  conditions  Json    @default("[]")

  // Actions: JSON array of { type, params }
  // Types: assign_user, set_priority, send_notification, add_tag, update_field, create_wos
  actions     Json    @default("[]")

  createdBy   User?   @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("automation_rules")
}

model TelegramPairing {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
  @@map("telegram_pairings")
}



